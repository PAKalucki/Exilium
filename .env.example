APP_ORIGIN=http://localhost:5173
# Optional exact extra origins, e.g. a temporary LAN HTTP URL. Comma-separated.
APP_ADDITIONAL_ORIGINS=
DATABASE_PATH=./data/exilium.sqlite
# Adapter limit; the portrait endpoint separately enforces 5 MB.
BODY_SIZE_LIMIT=6M
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord server (guild) whose members may sign in. Required for Discord login.
DISCORD_GUILD_ID=
# First administrator Discord user ID; protected against demotion while configured.
DEPLOYMENT_ADMIN_DISCORD_ID=
# Exactly APP_ORIGIN + /auth/discord/callback must be registered in Discord.
# Local preview only. Ignored in production builds. Never deploy as authentication.
DEV_LOGIN_ENABLED=false
